{
    "name": "modernmcguire/eavesdrop",
    "description": "A Laravel package that logs every outbound SMS and email, and can optionally intercept them before they send, with a UI to view them.",
    "keywords": [
        "modernmcguire",
        "eavesdrop",
        "laravel",
        "sms",
        "email",
        "mail",
        "notifications"
    ],
    "homepage": "https://github.com/modernmcguire/eavesdrop",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Matt Murtaugh",
            "email": "matt@modernmcguire.com",
            "role": "Developer"
        },
        {
            "name": "Ben Miller",
            "email": "ben@modernmcguire.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.5|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.0|^10.1|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "ModernMcGuire\\Eavesdrop\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ModernMcGuire\\Eavesdrop\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"

    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "ModernMcGuire\\Eavesdrop\\EavesdropServiceProvider"
            ]
        }
    }
}
